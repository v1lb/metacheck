<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Разрешения минимальные:
        - файлы выбираются и сохраняются через системные диалоги (SAF), READ_MEDIA_IMAGES не нужен;
        - ACCESS_MEDIA_LOCATION нужен, чтобы прочитать GPS в ваших фото (Android 10+ скрывает его без разрешения);
        - INTERNET нужен только по действию пользователя: карта OpenStreetMap (включается кнопкой) и
          необязательная отправка JSON-отчёта на адрес, который пользователь сам указал в настройках
          (по умолчанию выключено, только HTTPS, см. network_security_config).
        Изображения в сеть не уходят. Эти свойства проверяет ManifestSecurityTest.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <!--
        Аудит, п. 20. Библиотеки (в первую очередь osmdroid) могут добавлять свои разрешения в итоговый
        манифест. Доступ к общему хранилищу и Wi-Fi приложению не нужен: кэш карты лежит в приватных папках
        (MapTiles.configure), файлы идут через системные диалоги. Убираем их явно; если библиотека их
        не объявляет, правило ничего не меняет.
        ACCESS_NETWORK_STATE не убираем: osmdroid проверяет сеть перед загрузкой тайлов, без него падает.
        Итоговый набор разрешений собранного APK проверяет CI (tools/check_apk_permissions.py).
    -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />

    <application
        android:name=".MetaCheckApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MetaCheck"
        android:usesCleartextTraffic="false">

        <!-- Единственный экспортируемый компонент: нужен для запуска с лаунчера. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- «Поделиться» из галереи и мессенджеров. Принимаем только изображения. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Язык приложения на Android 8–12: AppCompat сам сохраняет выбор (на 13+ его хранит система). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Нужен только для снимка с камеры: файл во временной папке cache/camera, наружу не экспортируется. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
