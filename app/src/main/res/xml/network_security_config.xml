<?xml version="1.0" encoding="utf-8"?>
<!--
    Строгая сетевая политика: только HTTPS и только системные центры сертификации.
    Сеть используется по действию пользователя: тайлы карты OpenStreetMap и необязательная отправка
    JSON-отчёта на адрес, который пользователь задал в настройках.

    Версию TLS эта конфигурация не выбирает: минимум задаётся в HTTP-клиенте (OkHttp ConnectionSpec).

    SSL-pinning для адреса API пользователь включает сам в настройках (поле «pin сертификата»).
    Жёстко прописать пины здесь нельзя: адрес сервера заранее неизвестен.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Только системные центры сертификации, пользовательские не доверяем. -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
