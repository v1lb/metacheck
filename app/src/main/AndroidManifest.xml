<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Разрешения минимальные:
        - файлы выбираются и сохраняются через системные диалоги (SAF), READ_MEDIA_IMAGES не нужен;
        - INTERNET нужен только для необязательной отправки JSON-отчёта на адрес, который пользователь
          сам указал в настройках (по умолчанию выключено, только HTTPS, см. network_security_config).
        Изображения в сеть не уходят. Эти свойства проверяет ManifestSecurityTest.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".MetaCheckApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MetaCheck"
        android:usesCleartextTraffic="false">

        <!-- Единственный экспортируемый компонент: нужен для запуска с лаунчера. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- «Поделиться» из галереи и мессенджеров. Принимаем только изображения. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Нужен только для снимка с камеры: файл во временной папке cache/camera, наружу не экспортируется. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
